{
  "name": "raw-studio",
  "version": "1.0.0",
  "description": "RAW Studio photo editor",
  "main": "main.js",
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.example.rawstudio",
    "productName": "RAW Studio",
    "files": ["index.html", "main.js"],
    "artifactName": "RAW-Studio-${version}.${ext}",
    "linux": {
      "target": ["AppImage"],
      "category": "Graphics"
    },
    "win": {
      "target": ["portable"]
    }
  }
}
